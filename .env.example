# Copy to .env: `cp .env.example .env`. Local development values only, no real secret.

# Ports on your machine (inside Docker, the services keep 80 and 3306).
APP_PORT=8050
DB_PORT=3350

# Base URL used for canonical links.
APP_URL=http://localhost:8050

# Database used by the application (tests force catalog_test, see phpunit.xml).
DB_HOST=db
DB_NAME=catalog
DB_USER=app
DB_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password

# Products API.
PRODUCTS_API_URL=https://fakestoreapi.com
PRODUCTS_API_CURRENCY=EUR
PRODUCTS_PER_PAGE=10

# Product cache lifetime, in seconds.
CACHE_TTL=300
